# =============================================================
#  Cruz Estudio — configuración Apache (URLs limpias + performance)
# =============================================================

# Evita que la negociación automática de Apache interfiera con las URLs limpias
Options -MultiViews -Indexes

# Página de inicio por defecto
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase /

  # ── 1) Forzar HTTPS + www (canónico: https://www.cruzestudio.com.ar) ──
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

  # ── 2) Servir WebP automáticamente si el navegador lo soporta ──
  #     Si existe foo.webp junto a foo.jpg/png y el navegador manda
  #     Accept: image/webp, se sirve el WebP sin cambiar el <img src>.
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_URI} ^(.+)\.(jpe?g|png)$ [NC]
  RewriteCond %{DOCUMENT_ROOT}%1.webp -f
  RewriteRule .+ %1.webp [T=image/webp,E=accept:1,L]

  # ── 3) /index.html  ->  /  (301) ────────────────────────────
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # ── 4) /pages/foo.html  ->  /foo  (301, para SEO y links viejos) ─
  RewriteCond %{THE_REQUEST} \s/+pages/([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ── 5) /foo.html  ->  /foo  (por si alguien pide foo.html suelto) ─
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/pages/ [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ── 6) /foo  ->  sirve internamente /pages/foo.html (invisible) ──
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
  RewriteRule ^([^/]+)/?$ /pages/$1.html [L]
</IfModule>

# ── Vary: Accept para que caches/proxies distingan WebP ──
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

# Tipo MIME correcto para WebP (por si el servidor no lo trae)
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# =============================================================
#  COMPRESIÓN (Gzip / Brotli)
# =============================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript \
    application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json image/svg+xml application/xml \
    application/x-font-ttf font/opentype
</IfModule>

# =============================================================
#  CACHÉ DE NAVEGADOR (Expires)
# =============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML: siempre revalidar (para que los cambios se vean al toque)
  ExpiresByType text/html                 "access plus 0 seconds"
  # Imágenes / video / audio: 1 año (llevan ?v= o nombre único)
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType audio/mp4                 "access plus 1 year"
  ExpiresByType audio/x-m4a               "access plus 1 year"
  # CSS / JS: 1 mes (usan ?v= para cache-busting)
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType text/javascript           "access plus 1 month"
  # Fuentes
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Cache larga + inmutable para assets estáticos versionados
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|mp4|webm|m4a|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML sin cache agresiva
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# =============================================================
#  CABECERAS DE SEGURIDAD (básicas)
# =============================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
